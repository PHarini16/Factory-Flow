# Copy to backend/.env (local) and edit. NEVER commit the real .env file.
DATABASE_URL=sqlite:///./factoryflow.db
# Generate a strong key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo mode exposes /api/v1/demo/reset and /run-benchmark (OWNER only). Set false in production.
DEMO_MODE=true
AUTO_MIGRATE=true
# Load ~6 months of dummy history on first start
SEED_DEMO_DATA=true
LOGIN_RATE_LIMIT=10
FACTORY_NAME=Sri Murugan Snacks Pvt Ltd
FACTORY_GSTIN=33AAAAA0000A1Z5
FACTORY_ADDRESS=12 Industrial Estate, Coimbatore, Tamil Nadu 641001
FACTORY_STATE=Tamil Nadu
FACTORY_STATE_CODE=33
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg://factoryflow:factoryflow@db:5432/factoryflow
